# Cooler CRM — server configuration
# Copy to server/.env and fill in. Every variable is validated at boot by
# src/config/env.ts, so a bad value fails loudly instead of silently.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Database ---------------------------------------------------------------
# MUST point at a replica set. Spec §19 requires transactions, and MongoDB only
# provides them on a replica set. The project-local instance runs on 27018 —
# NOT the system MongoDB service on 27017, which is standalone.
# Start it with:  npm run db:start          See DECISIONS.md §2.
# Once the database has a password, it lives in this URI: the seed script masks
# user:password when it prints the URI, but treat this file as a secret.
MONGO_URI=mongodb://127.0.0.1:27018/cooler_crm?replicaSet=rs0

# ---- Auth -------------------------------------------------------------------
# Minimum 32 characters each. Generate each one separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# With NODE_ENV=production the server refuses to start if a secret below (or
# HAPPY_CODE_KEY) is still its placeholder, looks typed rather than random
# (very few different characters, or one short pattern repeated), or if the
# access and refresh secrets are the same. Development and test are not checked.
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url
JWT_REFRESH_SECRET=replace-me-with-a-different-48-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Happy Code -------------------------------------------------------------
# AES-256-GCM key: exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Encrypted rather than hashed so Admin can re-view and re-send a code the
# customer never received — otherwise a bad phone number makes a complaint
# permanently uncloseable. See DECISIONS.md §4.2.
#
# WARNING: losing this key makes every existing Happy Code unreadable, and
# those complaints can then only be closed by regenerating their codes.
HAPPY_CODE_KEY=replace-me-with-64-hex-characters
HAPPY_CODE_MAX_ATTEMPTS=5

# ---- Seed endpoint (temporary, remove after deployment is stable) -----------
# Secret key for the /seed endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# Leave empty or remove to disable the endpoint entirely.
SEED_KEY=

# ---- SLA (spec §14 — configurable, never hard-coded) ------------------------
# Whether the SLA clock pauses in these states. Both ship off; see DECISIONS.md §5.
SLA_PAUSE_ON_WAITING_PARTS=false
SLA_PAUSE_ON_REVISIT_REQUIRED=false

# ---- Time -------------------------------------------------------------------
# Timestamps are stored in UTC and displayed in this one company timezone.
APP_TIMEZONE=Asia/Kolkata

# ---- Attachments (spec §19 — access-controlled, never public) ---------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_MB=10
