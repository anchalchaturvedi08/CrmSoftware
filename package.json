{
  "name": "cooler-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Cooler CRM / After-Sales Service Management System",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "db:status": "node scripts/db-status.mjs",
    "predev": "node scripts/db-start.mjs",
    "dev": "npm run dev --workspace server",
    "test": "npm run test --workspace server",
    "smoke": "node scripts/smoke.mjs",
    "postman": "node scripts/generate-postman.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dev:web": "npm run dev --workspace client",
    "dev:api": "npm run dev --workspace server"
  }
}
